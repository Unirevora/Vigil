{
  "name": "vigil-inkpress",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "不眠手记 v1.5 — 单窗三态 Markdown、KaTeX 实时排版、自定义背景与主题色、双向笔记链接",
  "scripts": {
