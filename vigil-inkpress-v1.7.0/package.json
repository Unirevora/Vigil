{
  "name": "vigil-inkpress",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "不眠手记 v1.7.0：本地与 GitHub 双文库、统一三态编辑器、Obsidian Callout 与安全字体样式",
  "scripts": {
    "dev": "node scripts/build-css.mjs && node scripts/dev-server.mjs",
    "start": "node scripts/build-css.mjs && node scripts/dev-server.mjs",
    "test": "node --test tests/*.test.js",
    "fonts:restore": "python3 scripts/restore-fonts.py",
    "pack:fonts": "python3 scripts/pack-with-local-fonts.py",
    "build:css": "node scripts/build-css.mjs",
    "diagnose:github": "node scripts/diagnose-github.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
